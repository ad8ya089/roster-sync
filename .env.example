# PostgreSQL role; also used by the application datasource.
POSTGRES_USER=roster
# PostgreSQL database name; update SPRING_DATASOURCE_URL if changed.
POSTGRES_DB=rostersync
# Local demonstration password only; change before any public deployment.
POSTGRES_PASSWORD=local-roster-change-me
# JDBC URL inside the Compose network; host-run applications need their own DB URL.
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/rostersync
# Compose runs demo by default; use prod alone to exclude demo fixtures/endpoints.
SPRING_PROFILES_ACTIVE=demo
# Password shared by seeded demo users; change before public interview deployments.
DEMO_PASSWORD=demo-pass
# CHANGE ME: 48-byte development-only HS256 secret; never use this publicly.
JWT_SECRET=change-me-local-jwt-secret-0123456789abcdef01234
# JWT lifetime.
TOKEN_TTL=1h
# Fields reserved for the transport owner.
TRANSPORT_OWNED_FIELDS=PICKUP_POINT,SPECIAL_ASSISTANCE
# Persisted partition count; changing it requires a re-bucketing migration.
RECON_BUCKETS=256
# Inclusive missing-active ratio that stops reconciliation for approval.
BRAKE_MAX_MISSING_RATIO=0.30
# Optional absolute missing count; blank disables this extra guard.
BRAKE_MAX_MISSING_COUNT=
# Maximum planned actions applied per transaction.
RECON_CHUNK_SIZE=500
# Persistent upload/spill directory mounted as the appdata volume.
ROSTER_DATA_DIR=/data
# Optional inbox poller directory; blank disables polling.
RECON_INBOX_DIR=
# Planned-action JDBC insert batch size.
RECON_INSERT_BATCH_SIZE=1000
# Maximum queued reconciliation runs for the single worker.
RECON_QUEUE_CAPACITY=10
# Recovery watchdog interval.
RECON_RECOVERY_INTERVAL=5m
# Nightly inbox polling schedule (UTC); inactive without RECON_INBOX_DIR.
RECON_INBOX_CRON="0 0 1 * * *"
# Enable the outbox publisher when it is implemented in Phase 5.
OUTBOX_ENABLED=true
# Outbox polling delay.
OUTBOX_POLL_INTERVAL=500ms
# Maximum events claimed per outbox poll.
OUTBOX_BATCH_SIZE=100
# Failed publish attempts before DEAD status.
OUTBOX_MAX_ATTEMPTS=10
# Timeout per sink invocation.
OUTBOX_SINK_TIMEOUT=2s
# Receipt retention window.
RETENTION_RECEIPTS=30d
# Published outbox retention window.
RETENTION_OUTBOX=7d
# Completed reconciliation-action retention window.
RETENTION_RECON_ACTIONS=7d
# Consumer deduplication retention window.
RETENTION_PROCESSED_EVENTS=7d
# Uploaded-file audit retention window.
RETENTION_UPLOADED_FILES=7d
# Nightly retention schedule (UTC).
RETENTION_CRON="0 0 3 * * *"
# Office-reference cache lifetime.
OFFICE_CACHE_TTL=10m
# Maximum office-reference cache entries.
OFFICE_CACHE_MAXIMUM_SIZE=10000
# Employee read-view cache lifetime.
EMPLOYEE_CACHE_TTL=30s
# Maximum employee read-view cache entries.
EMPLOYEE_CACHE_MAXIMUM_SIZE=50000
# Interval for refreshing database-backed monitoring gauges.
METRICS_REFRESH_INTERVAL=15s
# Container JVM memory policy; Docker/CI both use Temurin 21.
JAVA_OPTS="-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError"
