        "uid": "prometheus",
        "type": "prometheus"
      },
      "title": "Events by outcome",
      "id": 1,
      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{outcome}}{{sink}}{{cache}}",
          "expr": "sum by (outcome) (rate(roster_events_total[5m]))"
        }
      ],
      "gridPos": {
        "w": 12,
        "y": 0.0,
        "x": 0,
        "h": 8
      },
