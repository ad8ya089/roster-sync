erDiagram
    direction TB
    tenant ||--o{ office : "tenant_id FK"
    tenant ||--o{ app_user : "tenant_id FK"
    tenant ||--o{ employee : "tenant_id FK"
    office |o--o{ employee : "office_id FK"
    employee |o..o{ cab_booking : "tenant + external ID; logical"
    employee |o..o{ route_seat : "tenant + external ID; logical"
    tenant {
        uuid id PK
        varchar code UK
    }
    office {
        bigint id PK
        uuid tenant_id FK
        varchar code
        boolean active
    }
    app_user {
        bigint id PK
        uuid tenant_id FK
        varchar username UK
        varchar role
        varchar employee_external_id
    }
    employee {
        bigint id PK
        uuid tenant_id FK
        varchar external_id
        bigint office_id FK
        varchar status
        bigint hr_version
        integer transport_version
    }
    cab_booking {
        bigint id PK
        uuid tenant_id
        varchar employee_external_id
        timestamptz pickup_at
        varchar status
    }
    route_seat {
        bigint id PK
        uuid tenant_id
        varchar route_code
        integer seat_no
        varchar employee_external_id
    }
